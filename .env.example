# Model provider (free tier)
OPENROUTER_API_KEY='your_api_key_here'

# Retrieval
DOCS_PATH=data/documentation.json
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.30

# Decision log (SQLite by default; a PostgreSQL URL also works)
DATABASE_URL=sqlite:///./storage/decisions.db

# Operations
LOG_LEVEL=INFO
KILL_SWITCH=false