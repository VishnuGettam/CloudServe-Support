# CloudServe Support Triage: configuration template.
# Copy to .env and put your own key in .env only (.env is ignored by git):
#     cp .env.example .env
# Every setting has a working default; only OPENROUTER_API_KEY needs a value.

# ---- Model provider (OpenRouter free models) ----
# Free key: https://openrouter.ai/keys. Without a key the system still runs:
# tickets that would be answered automatically escalate with MODEL_UNAVAILABLE.
OPENROUTER_API_KEY=your_key_here
# Models tried in order; keep models from different providers next to each other.
LLM_MODELS=nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
LLM_REASONING_EFFORT=low
LLM_COOLDOWN=120
LLM_RETRIES=1
LLM_RETRY_WAIT=8
LLM_TIMEOUT=30
LLM_MIN_INTERVAL=3.2
LLM_CACHE_PATH=storage/llm_cache.sqlite
GENERATOR_PROMPT=prompts/pr02_generator_v1.md

# ---- Data ----
DOCS_PATH=data/documentation.json
TRAIN_PATH=data/development_tickets.json

# ---- Retrieval ----
# Where the embedding model is cached (downloaded once, about 80 MB, on first run)
# EMBEDDING_MODEL_DIR=~/.cache/chroma/onnx_models/all-MiniLM-L6-v2/onnx
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.30

# ---- Classification, policy and routing ----
CLASSIFIER_EMBEDDINGS=false
POLICY_CONFIG=config/never_auto.yaml
CAVEATS_CONFIG=config/caveats.yaml
CONFIDENCE_THRESHOLD=0.80
CONFIDENCE_THRESHOLD_SENSITIVE=0.90

# ---- Orchestration ----
# langgraph (default), or sequential to run the same graph without LangGraph
ORCHESTRATOR=langgraph

# ---- Decision log (SQLite; leave empty to turn the log off) ----
DATABASE_URL=sqlite:///./storage/decisions.db

# ---- Monitoring (optional) ----
# Pushgateway that harness runs push their metrics to, e.g. http://localhost:9091
PUSHGATEWAY_URL=

# ---- Operations ----
LOG_LEVEL=INFO
KILL_SWITCH=false
