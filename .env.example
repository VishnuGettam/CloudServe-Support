# ---- Model provider (OpenRouter free models) ----
OPENROUTER_API_KEY=your_key_here


LLM_MODELS=nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
LLM_COOLDOWN=120
LLM_REASONING_EFFORT=low


LLM_CACHE_PATH=storage/llm_cache.sqlite
LLM_TIMEOUT=30
LLM_MIN_INTERVAL=3.2
GENERATOR_PROMPT=prompts/pr02_generator_v1.md

# ---- Data ----
DOCS_PATH=data/documentation.json
TRAIN_PATH=data/development_tickets.json

# ---- Retrieval ----
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.30

# ---- Classification and routing ----
CLASSIFIER_EMBEDDINGS=false
POLICY_CONFIG=config/never_auto.yaml
CONFIDENCE_THRESHOLD=0.80
CONFIDENCE_THRESHOLD_SENSITIVE=0.90

# ---- Decision log (SQLite by default; a PostgreSQL URL also works) ----
DATABASE_URL=sqlite:///./storage/decisions.db

# ---- Operations ----
LOG_LEVEL=INFO
KILL_SWITCH=false

DISABLE_SQLALCHEMY_CEXT_RUNTIME=1